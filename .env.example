# Copy to .env.local and fill in. Never commit .env.local.

# --- LLM ---
GEMINI_API_KEY=
# Main model (extraction, founder file, scoring). `npx tsx scripts/list-gemini-models.ts` lists what your key can use.
GEMINI_MODEL=gemini-3.8-flash
# High-volume classification + quota fallback
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Optional: embedding model (Phases 3 and 7)
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
# Optional: Groq fallback model
GROQ_MODEL=openai/gpt-oss-120b

# --- Research ---
TAVILY_API_KEY=

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Google (Gmail + Calendar). Leave blank to use the mock mailbox/calendar in the DB ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
FUND_SENDER_EMAIL=
KUSHAL_CALENDAR_ID=primary
ADITYA_CALENDAR_ID=

# --- Demo ---
# When true, every founder-bound email goes to DEMO_FOUNDER_EMAIL instead
DEMO_MODE=true
DEMO_FOUNDER_EMAIL=

# --- Cron ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=

# --- Access ---
# Basic Auth for the deployed app (leave APP_PASSWORD empty to disable locally)
APP_USER=allin
APP_PASSWORD=
